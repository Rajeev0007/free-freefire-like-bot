# Copy this file to .env and fill it in.

# Your Discord bot token (Developer Portal -> Bot -> Reset Token)
TOKEN=

# --- Choose ONE option ---

# Option 1: RapidAPI. Put your key here and leave API_HOST empty.
RAPIDAPI_KEY=

# Option 2: Your own API. Put its address here and leave RAPIDAPI_KEY empty.
API_HOST=
# Region used when someone runs /like without one (IND, BR, US, SAC, NA, BD, ...)
DEFAULT_REGION=IND
